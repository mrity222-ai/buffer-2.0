# Database & Redis
DATABASE_URL=postgresql+asyncpg://publisher:publisher_secret@localhost:5432/social_publisher
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & JWT
SECRET_KEY=change_this_to_a_super_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Meta Developer App
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8000/api/social/callback/meta
FRONTEND_URL=http://localhost:3000

# Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=social-publisher-media
